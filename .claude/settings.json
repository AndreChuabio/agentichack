{
  "extraKnownMarketplaces": {
    "claudemeow": {
      "source": {
        "source": "github",
        "repo": "Meowteam6/claudemeow"
      }
    }
  },
  "enabledPlugins": {
    "core@claudemeow": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pretooluse-guard.sh"
          }
        ]
      }
    ]
  }
}
